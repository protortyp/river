# ---------------------------------------------------------------------------
# River environment config -- TEMPLATE.
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- MLflow tracking server (optional) --------------------------------------
# Set MLFLOW_TRACKING_URI to enable remote experiment tracking when running
# with mlflow_enabled=true. USERNAME/PASSWORD are optional HTTP Basic Auth.
MLFLOW_TRACKING_URI=https://mlflow.example.com
MLFLOW_TRACKING_USERNAME=api
MLFLOW_TRACKING_PASSWORD=changeme

# --- Vast.ai (optional cloud GPU training) ----------------------------------
VAST_API_KEY=changeme
