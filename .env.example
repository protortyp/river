# ---------------------------------------------------------------------------
# pokergpu environment config -- TEMPLATE.
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. This template is the
# committed reference for which variables the code expects.
# ---------------------------------------------------------------------------

# --- MLflow tracking server -------------------------------------------------
# configure_mlflow() (train/mlflow_config.py) requires MLFLOW_TRACKING_URI.
# USERNAME/PASSWORD are HTTP Basic Auth credentials -- omit them if your
# tracking server has no auth. MLflow telemetry is optional: training runs
# fine without it (set mlflow_enabled=false, or leave these unset).
MLFLOW_TRACKING_URI=https://mlflow.example.com
MLFLOW_TRACKING_USERNAME=api
MLFLOW_TRACKING_PASSWORD=changeme

# --- vast.ai ----------------------------------------------------------------
# Reference values for renting GPUs. Not read by Python code today.
VAST_API_KEY=changeme
VAST_INSTANCE_ID=
VAST_SSH_HOST=
VAST_SSH_PORT=

# --- Web UI deploy (justfile `deploy` recipe) -------------------------------
DEPLOY_SSH_TARGET=user@your-server.example.com
DEPLOY_SERVER_PATH=/path/to/hosting-setup
